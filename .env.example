# --- Required ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
PORT=3000

# First admin, created by `npm run db:setup` if no admin exists
ADMIN_NAME=School Admin
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=ChangeMe123!

# --- Optional: online fee payment (Stripe Checkout) ---
# Dashboard -> Developers -> API keys; webhook endpoint: {BETTER_AUTH_URL}/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=inr

# --- Optional: email notifications (any SMTP provider) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pathshala <no-reply@school.local>"
